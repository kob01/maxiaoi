# ---------- Ollama ----------
# 容器内 localhost 指向容器自身, 必须经 host.docker.internal 访问宿主机 Ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
LLM_MODEL=qwen3.5
INTENT_MODEL=qwen3.5
EMBEDDING_MODEL=bge-m3
RERANK_MODEL=dengcao/bge-reranker-v2-m3

# ---------- RAG ----------
MILVUS_LITE_URI=./data/milvus_lite.db
MILVUS_COLLECTION=enterprise_knowledge
KNOWLEDGE_DIR=./data/knowledge
RAG_TOP_K=8
RERANK_TOP_N=4

# ---------- Assistant ----------
ASSISTANT_HOST=0.0.0.0
ASSISTANT_PORT=8000
MEMORY_MAX_TURNS=10
MEMORY_SUMMARY_THRESHOLD=20

# ---------- MCP Servers ----------
HR_MCP_URL=http://localhost:8001/mcp
FINANCE_MCP_URL=http://localhost:8002/mcp

# ---------- A2A Agents ----------
HR_AGENT_URL=http://localhost:9001
FINANCE_AGENT_URL=http://localhost:9002

# ---------- Security ----------
AUDIT_LOG_PATH=./logs/audit.jsonl

# ---------- MySQL 文档元数据(密码经 compose 注入容器, 不提交 git) ----------
MYSQL_HOST=47.116.208.170
MYSQL_PORT=3306
MYSQL_USER=sql47_116_208_1
MYSQL_DATABASE=sql47_116_208_1
MYSQL_CONNECT_TIMEOUT=10

# ---------- 文档上传 ----------
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_MB=50
VISION_MODEL=qwen3-vl
VISION_TIMEOUT=300
PARENT_CHUNK_MAX=1200
